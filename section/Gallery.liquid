{%- liquid
  assign color_scheme = props.color_scheme | default: 'scheme-1'
  assign alignment = props.alignment | default: 'left'
  assign columns = props.columns | default: '3'
  assign pad_top = props.padding_top | default: 80
  assign pad_bottom = props.padding_bottom | default: 80
-%}
<section
  class="section color-{{ color_scheme }}"
  style="--section-padding-top: {{ pad_top }}px; --section-padding-bottom: {{ pad_bottom }}px;"
>
  <div class="wrap">
    {%- if props.eyebrow or props.title or props.description -%}
      <div class="section__lead" style="margin-bottom: 2rem; {% if alignment == 'center' %}text-align: center;{% endif %}">
        {%- if props.eyebrow and props.eyebrow != blank -%}
          <span class="eyebrow">{{ props.eyebrow }}</span>
        {%- endif -%}
        {%- if props.title and props.title != blank -%}
          <h2>{{ props.title }}</h2>
        {%- endif -%}
        {%- if props.description and props.description != blank -%}
          <p style="margin-top: 0.5rem; opacity: 0.75;">{{ props.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="gallery gallery--{{ columns }}">
      {%- for block in blocks -%}
        {%- if block.type == 'gallery-image' -%}
          {%- assign image = block.settings.image | default: block.settings.imageUrl -%}
          {%- if image and image != blank -%}
            <figure class="gallery-item">
              <img src="{{ image | image_url: 'width=1200,quality=80,format=webp' }}" alt="{{ block.settings.alt | default: '' }}" loading="lazy">
              {%- if block.settings.caption and block.settings.caption != blank -%}
                <figcaption style="padding: 0.5rem 0.75rem; font-size: 0.85rem; opacity: 0.75;">{{ block.settings.caption }}</figcaption>
              {%- endif -%}
            </figure>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Galeri",
  "category": "Görsel",
  "settings": [
    { "type": "header", "label": "Başlık" },
    { "type": "text", "id": "eyebrow", "label": "Üst başlık" },
    { "type": "text", "id": "title", "label": "Başlık" },
    { "type": "textarea", "id": "description", "label": "Alt metin", "rows": 2 },

    { "type": "header", "label": "Düzen" },
    { "type": "select", "id": "columns", "label": "Sütun sayısı", "options": [
      { "label": "2 sütun", "value": "2" },
      { "label": "3 sütun", "value": "3" },
      { "label": "4 sütun", "value": "4" }
    ]},
    { "type": "alignment", "id": "alignment", "label": "Başlık hizalama" },
    { "type": "range", "id": "padding_top", "label": "Üst boşluk", "min": 0, "max": 200, "step": 8, "suffix": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Alt boşluk", "min": 0, "max": 200, "step": 8, "suffix": "px" },

    { "type": "header", "label": "Renk" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması" }
  ],
  "blocks": [
    { "type": "gallery-image", "max": 24 }
  ],
  "presets": [
    {
      "name": "Galeri — 3 kolon",
      "settings": {
        "title": "Çalışmalarımız",
        "columns": "3",
        "color_scheme": "scheme-1"
      }
    },
    {
      "name": "Galeri — 4 kolon kompakt",
      "settings": {
        "title": "Portfolyo",
        "columns": "4",
        "alignment": "center",
        "color_scheme": "scheme-1"
      }
    }
  ]
}
{% endschema %}
